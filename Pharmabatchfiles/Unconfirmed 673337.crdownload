/* ─────────────────────────────────────────
   PREMIUM SEND BUTTON
───────────────────────────────────────── */




    .chat-bubble-bot {
    background:
        linear-gradient(
            135deg,
            #ffffff 0%,
            #f8fbff 100%
        );

    color: #1e293b;

    border: 1px solid #dbeafe;

    padding: 14px 16px;

    border-radius: 18px 18px 18px 6px;

    font-size: 13px;

    line-height: 1.75;

    white-space: pre-wrap;

    max-width: 88%;

